# 生产环境请将该文件复制到 /etc/argus/argus.env，权限设为 600。
ARGUS_LISTEN=127.0.0.1:8080
ARGUS_DB=/var/lib/argus/argus.db
ARGUS_ADMIN_USER=admin
ARGUS_ADMIN_PASS=change-me-before-production

# 可选 GeoIP HTTP provider 基础 URL。服务端请求 <endpoint>/<ip>，响应 JSON 需含
# country_code 或 countryCode；留空不查询，地图无定位数据时安全隐藏。
ARGUS_GEOIP_ENDPOINT=
# NAT 简化 Host 反向代理监听地址；留空默认 :9090。仅绑定回环时需由反向代理接入。
ARGUS_NAT_LISTEN=:9090
# 可选固定 JWT 签名密钥；留空时自动生成并持久化到 ARGUS_DB.jwt。
# 多实例必须共享同一高强度随机值，且文件权限应保持 600。
ARGUS_JWT_SECRET=
# 可信反向代理（逗号分隔 IP/CIDR），直连部署留空
ARGUS_TRUSTED_PROXIES=
