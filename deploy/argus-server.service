[Unit]
Description=Argus monitoring server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=argus
Group=argus
WorkingDirectory=/opt/argus
EnvironmentFile=-/etc/argus/argus.env
ExecStart=/usr/local/bin/argus-server
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/argus

[Install]
WantedBy=multi-user.target
