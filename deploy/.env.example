# 复制为 deploy/.env 后修改为高强度密码。
ARGUS_ADMIN_USER=admin
# 至少 12 个字符；Compose 会拒绝缺失值。
ARGUS_ADMIN_PASS=replace-with-a-unique-strong-password
ARGUS_HTTP_PORT=8080
ARGUS_NAT_PORT=9090

# 可选 GeoIP HTTP provider 基础 URL。服务端请求 <endpoint>/<ip>，响应 JSON 需含
# country_code 或 countryCode。留空不查询；地图无国家码时会安全隐藏。
ARGUS_GEOIP_ENDPOINT=

# NAT Host 反向代理监听地址。留空时服务端默认 :9090；Compose 显式使用
# 0.0.0.0:9090，以匹配上方端口映射并保持现有行为。
ARGUS_NAT_LISTEN=0.0.0.0:9090

# Compose 必填，至少 32 字符。多实例部署必须设置相同的高强度随机值；不要提交真实密钥。
ARGUS_JWT_SECRET=replace-with-at-least-32-random-characters

# 可信反向代理（逗号分隔 IP/CIDR）。直连部署留空；nginx 反代时填代理地址，
# 否则 ClientIP 会记录代理而不是真实客户端。
ARGUS_TRUSTED_PROXIES=
